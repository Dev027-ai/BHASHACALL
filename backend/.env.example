# BhashaCall backend environment template. Copy to .env and add your own secret.
# Never commit backend/.env or place credentials in frontend/VITE_* variables.
GNANI_API_KEY=

# Gnani Timbre v2.5 WebSocket TTS endpoint (verified integration endpoint).
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE_HI=hi-IN
GNANI_TTS_LANGUAGE_EN=en-IN
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_SPEED=1.0
GNANI_TTS_SAMPLE_RATE=48000
GNANI_TTS_TIMEOUT=90
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_AUTH_SCHEME=

# Gnani STT uses the official gnani-vachana Python SDK.
# REST endpoint: https://api.vachana.ai/stt/v3
# Real-time WebSocket: wss://api.vachana.ai/stt/v3/stream
GNANI_STT_LANGUAGE_HI=hi-IN
GNANI_STT_LANGUAGE_EN=en-IN

# Translation is separate from Gnani speech. Change to an approved provider if needed.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_API_KEY=

# Local OCR for scanned PDFs. Install Tesseract OCR separately on Windows.
OCR_LANGUAGES=eng+hin
OCR_DPI=300
OCR_MAX_PAGES=150
# Example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTED_CHARS=2000000
# Optional overrides; default paths are under backend/.
# DATABASE_PATH=./bhashacall.db
# DOCUMENT_STORAGE_PATH=./storage/documents
# AUDIO_STORAGE_PATH=./storage/audio
